# =============================================================================
# .env.example — copy to .env and fill in real values
# =============================================================================

# MySQL / MariaDB
MYSQL_HOST=db               # docker-compose service name; use 127.0.0.1 for local dev
MYSQL_PORT=3306
MYSQL_USER=ocruser
MYSQL_PASSWORD=ocrpassword  # change in production!
MYSQL_DATABASE=ocrdatabasedb

# Root password (only used by the db service itself)
MYSQL_ROOT_PASSWORD=rootpassword  # change in production!

