# =============================================================================
# .env.example — copy to .env and fill in real values
# =============================================================================

# MySQL / MariaDB
MYSQL_HOST=db               # docker-compose service name; use 127.0.0.1 for local dev
MYSQL_PORT=3306
MYSQL_USER=ocruser
MYSQL_PASSWORD=ocrpassword  # change in production!
MYSQL_DATABASE=ocrdatabasedb

# Root password (only used by the db service itself)
MYSQL_ROOT_PASSWORD=rootpassword  # change in production!

# -----------------------------------------------------------------------------
# Security & Authentication Configuration
# -----------------------------------------------------------------------------
# API authentication key for REST endpoints (X-API-Key or Bearer header).
# Leave empty in local development if auth is not needed.
OCR_API_KEY=

# When set to true or when ENVIRONMENT=production, requests without a valid
# OCR_API_KEY will be rejected (HTTP 401/500).
REQUIRE_AUTH=false

# Environment mode ('development' or 'production')
ENVIRONMENT=development

# Allowed CORS origins (comma-separated URLs, or '*' for open access)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Trusted reverse-proxy IP addresses (comma-separated, e.g. 127.0.0.1,172.18.0.1)
# When set, X-Forwarded-For is trusted only from these proxy IPs.
TRUSTED_PROXIES=


